@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 p-4">
                <h2 class="text-center fw-bold text-dark mb-4">Yeni Personel Kayıt Formu</h2>
                <hr />
                <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.AdSoyad" class="form-control" aria-required="true" placeholder="Ad Soyad" />
                        <label asp-for="Input.AdSoyad">Ad Soyad</label>
                        <span asp-validation-for="Input.AdSoyad" class="text-danger"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                        <label asp-for="Input.Email">E-Posta Adresi</label>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                        <label asp-for="Input.Password">Şifre</label>
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                        <label asp-for="Input.ConfirmPassword">Şifre Tekrar</label>
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <select asp-for="Input.DepartmanId" class="form-control" aria-required="true">
                            <option value="">-- Departman Seçiniz --</option>
                            <option value="1">Yazılım Geliştirme (ID: 1)</option>
                            <option value="2">İnsan Kaynakları (ID: 2)</option>
                            <option value="3">Muhasebe ve Finans (ID: 3)</option>
                        </select>
                        <label asp-for="Input.DepartmanId">Görev Alacağı Departman</label>
                        <span asp-validation-for="Input.DepartmanId" class="text-danger"></span>
                    </div>

                    <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary rounded-pill shadow-sm">Kayıt Ol ve Sisteme Ekle</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
