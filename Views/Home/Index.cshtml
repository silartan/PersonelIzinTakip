@{
    ViewData["Title"] = "Yönetim Paneli";
}

<div class="container mt-4 pb-5">
    @* --- ÜST KARŞILAMA VE KİŞİSEL ÖZET --- *@
    <div class="row mb-4">
        <div class="col-12">
            <div class="p-4 bg-white shadow-sm rounded-4 border-0 d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="fw-bold mb-1">Merhaba, @User.Identity.Name! 👋</h2>
                    <p class="text-muted mb-0">Bugün @DateTime.Now.ToString("dd MMMM yyyy, dddd")</p>
                </div>
                <div class="d-none d-md-flex gap-3">
                    <div class="text-end">
                        <small class="text-muted d-block">Kalan İzniniz</small>
                        <span class="fw-bold fs-5 text-success">@ViewBag.KalanIzin Gün</span>
                    </div>
                    <div class="vr"></div>
                    <div class="text-end">
                        <small class="text-muted d-block">Bekleyen Talebiniz</small>
                        <span class="fw-bold fs-5 text-warning">@ViewBag.BekleyenSayisi Adet</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* --- MÜDÜR ÖZEL: YÖNETİCİ İSTATİSTİKLERİ --- *@
    @if (User.IsInRole("Mudur"))
    {
        <div class="row g-4 mb-5">
            <div class="col-12">
                <h5 class="fw-bold text-secondary text-uppercase mb-3" style="letter-spacing: 1px;">
                    <i class="fa-solid fa-chart-line me-2"></i>Yönetici Özet Paneli
                </h5>
            </div>

            @* Toplam Personel Kartı *@
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted text-uppercase mb-2" style="font-size: 0.75rem;">Toplam Personel</h6>
                                <h2 class="display-5 fw-bold mb-0 text-dark">@ViewBag.ToplamPersonel</h2>
                            </div>
                            <div class="bg-primary bg-opacity-10 p-3 rounded-4">
                                <i class="fa-solid fa-users fa-2x text-primary"></i>
                            </div>
                        </div>
                        <div class="mt-3 small">
                            <span class="text-success"><i class="fa-solid fa-circle-check"></i> Aktif Liste</span>
                        </div>
                    </div>
                </div>
            </div>

            @* Bugün İzinli Olanlar *@
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted text-uppercase mb-2" style="font-size: 0.75rem;">Bugün İzinli</h6>
                                <h2 class="display-5 fw-bold mb-0 text-danger">@ViewBag.BugunIzinliOlanlar</h2>
                            </div>
                            <div class="bg-danger bg-opacity-10 p-3 rounded-4">
                                <i class="fa-solid fa-user-slash fa-2x text-danger"></i>
                            </div>
                        </div>
                        <div class="mt-3 small">
                            <a asp-controller="Izin" asp-action="Index" class="text-decoration-none text-muted">
                                Detayları gör <i class="fa-solid fa-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            @* Kritik Bekleyenler *@
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100 border-start border-warning border-5">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted text-uppercase mb-2" style="font-size: 0.75rem;">Onay Bekleyenler</h6>
                                <h2 class="display-5 fw-bold mb-0 text-warning">@ViewBag.OnayBekleyenToplam</h2>
                            </div>
                            <div class="bg-warning bg-opacity-10 p-3 rounded-4">
                                <i class="fa-solid fa-hourglass-half fa-2x text-warning"></i>
                            </div>
                        </div>
                        <div class="mt-3">
                            <a asp-controller="Izin" asp-action="OnayBekleyenler" class="btn btn-warning btn-sm w-100 rounded-pill fw-bold">
                                Hemen İncele
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    @* --- HIZLI ERİŞİM VE SİSTEM BİLGİSİ --- *@
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="p-4 bg-white shadow-sm rounded-4 h-100">
                <h5 class="fw-bold mb-4">Hızlı İşlemler</h5>
                <div class="row g-3">
                    <div class="col-md-6">
                        <a asp-controller="Izin" asp-action="TalepEt" class="btn btn-light border p-4 w-100 text-start rounded-4 hover-shadow transition">
                            <i class="fa-solid fa-plus-circle fa-2x text-primary mb-3"></i>
                            <h6 class="fw-bold mb-1">Yeni İzin İste</h6>
                            <p class="small text-muted mb-0">Hızlıca form doldurarak onaya gönderin.</p>
                        </a>
                    </div>
                    <div class="col-md-6">
                        <a asp-controller="Izin" asp-action="Index" class="btn btn-light border p-4 w-100 text-start rounded-4 hover-shadow transition">
                            <i class="fa-solid fa-clock-rotate-left fa-2x text-info mb-3"></i>
                            <h6 class="fw-bold mb-1">Geçmiş Taleplerim</h6>
                            <p class="small text-muted mb-0">Eski izinlerinizi ve durumlarını inceleyin.</p>
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="p-4 bg-dark text-white shadow-sm rounded-4 h-100">
                <h5 class="fw-bold mb-3"><i class="fa-solid fa-circle-info me-2 text-warning"></i>Bilgilendirme</h5>
                <ul class="list-unstyled small opacity-75">
                    <li class="mb-3 d-flex">
                        <i class="fa-solid fa-check-double mt-1 me-2 text-success"></i>
                        <span>Onaylanan izinler sistemden otomatik olarak düşülür.</span>
                    </li>
                    <li class="mb-3 d-flex">
                        <i class="fa-solid fa-check-double mt-1 me-2 text-success"></i>
                        <span>İzin taleplerinizi en az 3 iş günü önce yapmalısınız.</span>
                    </li>
                    <li class="d-flex">
                        <i class="fa-solid fa-check-double mt-1 me-2 text-success"></i>
                        <span>Yıllık bakiye her yılın başında otomatik yenilenir.</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<style>
    .rounded-4 {
        border-radius: 1.25rem !important;
    }

    .hover-shadow:hover {
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
        background-color: #fff !important;
    }

    .transition {
        transition: all 0.3s ease;
    }
</style>

