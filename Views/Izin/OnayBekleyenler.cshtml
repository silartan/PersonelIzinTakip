@model IEnumerable<PersonelIzinTakip.Models.IzinTalep>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="fw-bold text-dark"><i class="fa-solid fa-user-check me-2 text-primary"></i>Müdür Onay Paneli</h2>
            <p class="text-muted small">Şu anda onay bekleyen <b>@Model.Count()</b> adet izin talebi bulunmaktadır.</p>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Personel Bilgisi</th>
                        <th>İzin Tarihleri</th>
                        <th class="text-center">Süre</th>
                        <th>Açıklama</th>
                        <th class="text-end pe-4">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-mug-hot fa-3x mb-3 opacity-25"></i>
                                <p>Şu an onay bekleyen herhangi bir talep bulunmuyor.</p>
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center">
                                    <div class="avatar-circle me-3 bg-primary text-white d-flex align-items-center justify-content-center rounded-circle" style="width: 40px; height: 40px; font-size: 14px;">
                                        @(item.User?.AdSoyad?.Substring(0, 1).ToUpper() ?? "P")
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark">@item.User?.AdSoyad</div>
                                        <div class="text-muted small">Kalan İzin: @(item.User?.KalanIzinGun) Gün</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="small fw-bold text-dark">
                                    <i class="fa-regular fa-calendar-days me-1 text-primary"></i>
                                    @item.BaslangicTarihi.ToShortDateString() - @item.BitisTarihi.ToShortDateString()
                                </div>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-secondary rounded-pill">@item.GunSayisi Gün</span>
                            </td>
                            <td>
                                <span class="text-muted small">@(string.IsNullOrEmpty(item.Aciklama) ? "-" : item.Aciklama)</span>
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-flex justify-content-end gap-2">
                                    @* Onayla Butonu - JS ile tetiklenir *@
                                    <button type="button" class="btn btn-success btn-sm px-3" onclick="confirmAction('@item.Id', 'Onayla', '@item.User?.AdSoyad')">
                                        <i class="fa-solid fa-check me-1"></i> Onayla
                                    </button>

                                    @* Reddet Butonu - JS ile tetiklenir *@
                                    <button type="button" class="btn btn-outline-danger btn-sm px-3" onclick="confirmAction('@item.Id', 'Reddet', '@item.User?.AdSoyad')">
                                        <i class="fa-solid fa-xmark me-1"></i> Reddet
                                    </button>

                                    @* Gizli Formlar *@
                                    <form id="form-Onayla-@item.Id" asp-action="Onayla" asp-route-id="@item.Id" method="post"></form>
                                    <form id="form-Reddet-@item.Id" asp-action="Reddet" asp-route-id="@item.Id" method="post"></form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmAction(id, action, name) {
            const isApprove = action === 'Onayla';

            Swal.fire({
                title: isApprove ? 'Onaylıyor musunuz?' : 'Reddediyor musunuz?',
                text: `${name} isimli personelin izin talebi ${isApprove ? 'onaylanacak ve izninden düşülecektir.' : 'reddedilecektir.'}`,
                icon: isApprove ? 'question' : 'warning',
                showCancelButton: true,
                confirmButtonColor: isApprove ? '#198754' : '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: isApprove ? 'Evet, Onayla' : 'Evet, Reddet',
                cancelButtonText: 'Vazgeç'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById(`form-${action}-${id}`).submit();
                }
            });
        }
    </script>
}