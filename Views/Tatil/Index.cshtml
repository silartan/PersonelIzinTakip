@model IEnumerable<PersonelIzinTakip.Models.Holiday>

@{
    ViewData["Title"] = "Resmi Tatil Yönetimi";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Resmi Tatiller</h2>
        <a asp-action="Ekle" class="btn btn-primary">Yeni Tatil Ekle</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <table class="table table-bordered table-striped mt-3">
        <thead class="table-dark">
            <tr>
                <th>Tatil Adı</th>
                <th>Tarih Aralığı</th>
                <th>Tür</th>
                <th>İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                // Harika Kısım: Tatilleri İsmine ve Yılına göre grupluyoruz!
                var grupluTatiller = Model
                .GroupBy(t => new { t.Name, Year = t.Date.Year })
                .OrderBy(g => g.Min(x => x.Date));

                @foreach (var grup in grupluTatiller)
                {
                    <tr>
                        <td class="fw-bold">@grup.Key.Name</td>
                        <td>
                            @if (grup.Min(x => x.Date) == grup.Max(x => x.Date))
                            {
                                <span>@grup.Min(x => x.Date).ToString("dd.MM.yyyy")</span>
                            }
                            else
                            {
                                <span>@grup.Min(x => x.Date).ToString("dd.MM.yyyy") - @grup.Max(x => x.Date).ToString("dd.MM.yyyy")</span>
                            }
                        </td>
                        <td>
                            @if (grup.First().IsHalfDay)
                            {
                                <span class="badge bg-warning text-dark">Yarım Gün (Arife vs.)</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Tam Gün</span>
                            }
                        </td>
                        <td>
                            <form asp-action="Sil" asp-route-name="@grup.Key.Name" method="post" onsubmit="return confirm('Bu tatili silmek istediğinize emin misiniz?');">
                                <button type="submit" class="btn btn-danger btn-sm">Sil</button>
                            </form>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center">Henüz sisteme eklenmiş bir tatil bulunmuyor.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
